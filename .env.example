# Copy to .env and fill in. Never commit .env.
# Secret key: Adapty dashboard -> App settings -> General -> Secret key (sandbox app only).
ADAPTY_SECRET_KEY=
# Public SDK key of the same app (safe to share): App settings -> General.
ADAPTY_PUBLIC_KEY=
# Paywall placement whose audiences include the "Referred users" segment.
ADAPTY_PLACEMENT_ID=main_paywall
# Access level granted as the reward.
ADAPTY_ACCESS_LEVEL=premium
# Port the demo listens on (0.0.0.0, so the laptop can reach it over Tailscale).
PORT=8080

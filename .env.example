# Copy to .env and fill in. Never commit .env (this repo is public).
# Leave ADAPTY_SECRET_KEY empty to run in mock mode (no network, nothing needed).
# Live mode: Adapty -> app "Teodor sandbox (test)" -> App settings -> General -> Secret key.
ADAPTY_SECRET_KEY=
# Public SDK key of the same app (safe to share).
ADAPTY_PUBLIC_KEY=public_live_RJYbHI3U.4KTyAa71yQ6chGVoWZqK
ADAPTY_PLACEMENT_ID=main_paywall
ADAPTY_ACCESS_LEVEL=premium
# Password for /dashboard (any user name). Empty = no login, fine locally.
ADMIN_PASSWORD=
# Optional: fixed webhook Authorization value; by default it's derived from the secret key.
# WEBHOOK_SECRET=
PORT=8080
